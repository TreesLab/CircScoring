from pathlib import Path
import csv


WORKFLOW_DIR = Path(workflow.basedir).resolve()
configfile: str(WORKFLOW_DIR / "config/config.yaml")

REPO = WORKFLOW_DIR.parent
RESULTS = (REPO / config["results_root"]).resolve()
PYTHON = config["python"]
LIFTOVER = config["liftover_bin"]
RUNNER_JOBS = int(config.get("runner_jobs", 1))


def repo_path(value):
    path = Path(value)
    return str(path if path.is_absolute() else REPO / path)


def result_path(value):
    return str(RESULTS / value)


def read_tsv(path):
    with Path(path).open(newline="") as handle:
        return list(csv.DictReader(handle, delimiter="\t"))


def source_outputs(manifest):
    manifest = Path(manifest).resolve()
    outputs = []
    for row in read_tsv(manifest):
        source = (manifest.parent / row["path"]).resolve()
        outputs.append(str(RESULTS / source.relative_to(REPO)))
    return outputs


HUMAN_T1 = {row["database"]: row for row in read_tsv(REPO / "workflow/config/human_tier1.tsv")}
MOUSE_T1 = {row["database"]: row for row in read_tsv(REPO / "workflow/config/mouse_tier1.tsv")}
