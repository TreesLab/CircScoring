rule create_maxentscan_fasta:
    input:
        genome = GENOME,
        five_prime_bed = f"{MAXENT_ROOT}/circRNAs.5p.bed",
        three_prime_bed = f"{MAXENT_ROOT}/circRNAs.3p.bed"
    output:
        five_prime_fa = f"{MAXENT_ROOT}/circRNAs.5p.fa",
        three_prime_fa = f"{MAXENT_ROOT}/circRNAs.3p.fa"
    log:
        f"{MAXENT_ROOT}/circRNAs.fasta.log"
    conda:
        "envs/mapping.yaml"
    script:
        "scripts/get_maxentscan_fasta.py"


rule run_maxentscan:
    input:
        five_prime_fa = f"{MAXENT_ROOT}/circRNAs.5p.fa",
        three_prime_fa = f"{MAXENT_ROOT}/circRNAs.3p.fa"
    output:
        five_prime_results = f"{MAXENT_ROOT}/circRNAs.5p.results",
        three_prime_results = f"{MAXENT_ROOT}/circRNAs.3p.results"
    log:
        f"{MAXENT_ROOT}/circRNAs.results.log"
    conda:
        "envs/maxentscan.yaml"
    shell:
        "(python scripts/run_maxentscan_skip_ambiguous.py --mode 5 "
        "--input {input.five_prime_fa:q} --output {output.five_prime_results:q} && "
        "python scripts/run_maxentscan_skip_ambiguous.py --mode 3 "
        "--input {input.three_prime_fa:q} --output {output.three_prime_results:q}) "
        "2> {log:q}"


