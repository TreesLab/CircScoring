# Shared reference-derived indexes

rule build_annotation_database:
    input:
        ANNOTATION
    output:
        ANNOTATION_DB
    log:
        f"{ANNOTATION_DB}.log"
    conda:
        "envs/circmimi.yaml"
    shell:
        "mkdir -p $(dirname {output:q}) && "
        "circmimi_tools gendb {input:q} {output:q} 2> {log:q}"


rule build_alternative_splicing_site_index:
    input:
        anno_db = ANNOTATION_DB
    output:
        site_index = AS_SITE_INDEX
    log:
        f"{AS_SITE_INDEX}.log"
    conda:
        "envs/circmimi.yaml"
    script:
        "scripts/build_alternative_splicing_site_index.py"


rule liftover_mouse_presence_to_hg38:
    input:
        table = MOUSE_PRESENCE,
        chain = MOUSE_CHAIN
    output:
        mapped = MOUSE_HG38,
        unmapped = MOUSE_UNMAPPED
    log:
        f"{MOUSE_HG38}.log"
    threads:
        MOUSE_LIFTOVER_THREADS
    conda:
        "envs/liftover.yaml"
    params:
        liftover = "liftOver"
    script:
        "scripts/liftover_mouse_presence.py"


rule liftover_circfl_table_to_hg38:
    input:
        table = CIRCFL_TABLE,
        chain = CIRCFL_CHAIN
