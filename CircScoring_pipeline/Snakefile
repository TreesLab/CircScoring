# Optional pblat-based alignment ambiguity analysis

def checkaa_other_references(wildcards):
    if not CHECKAA_OTHER_REFERENCES:
        raise ValueError(
            "checkAA.other_references must be specified when running checkAA"
        )
    return str(CHECKAA_OTHER_REFERENCES)


def checkaa_chunk_names(wildcards):
    chunk_directory = checkpoints.split_checkaa_input.get().output.chunks
    pattern = os.path.join(str(chunk_directory), "{chunk}.tsv")
    chunks = sorted(glob_wildcards(pattern).chunk)
    if not chunks:
        raise ValueError("checkAA input splitting produced no chunks")
    return chunks


def checkaa_chunk_input(wildcards):
    chunk_directory = checkpoints.split_checkaa_input.get().output.chunks
    return os.path.join(str(chunk_directory), f"{wildcards.chunk}.tsv")


def checkaa_chunk_results(wildcards):
    return expand(
        f"{CHECKAA_ROOT}/results/{{chunk}}.tsv",
        chunk=checkaa_chunk_names(wildcards),
    )


checkpoint split_checkaa_input:
    input:
        circRNAs = ACTIVE_CIRCRNAS
    output:
        chunks = directory(CHECKAA_CHUNKS)
    params:
        chunk_size = CHECKAA_CHUNK_SIZE
    conda:
        "envs/python.yaml"
    script:
        "scripts/split_checkaa_input.py"


rule run_checkaa_chunk:
    input:
        table = checkaa_chunk_input,
        genome = GENOME,
        other_references = checkaa_other_references
    output:
        result = temp(f"{CHECKAA_ROOT}/results/{{chunk}}.tsv")
    log:
        f"{CHECKAA_ROOT}/logs/{{chunk}}.log"
    threads:
        CHECKAA_THREADS
    params:
        flank_length = CHECKAA_FLANK_LENGTH,
        pblat = "pblat"
    wildcard_constraints:
        chunk = "part_[0-9]{6}"
    conda:
        "envs/checkAA.yaml"
    script:
        "scripts/run_checkaa_chunk.py"


rule merge_checkaa_results:
    input:
        circRNAs = ACTIVE_CIRCRNAS,
        results = checkaa_chunk_results
    output:
        CHECKAA_RESULT
    conda:
        "envs/python.yaml"
    script:
        "scripts/merge_checkaa_results.py"


rule merge_results_with_checkaa:
