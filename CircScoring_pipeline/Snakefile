import os
import re
from pathlib import Path


RELEASE_ROOT = Path(workflow.basedir).resolve()

workdir: str(RELEASE_ROOT)
configfile: str(RELEASE_ROOT / "config.yaml")


def required_config(path, value):
    if value is None or value == "":
        raise ValueError(f"Missing required config value: {path}")
    return str(value)


INPUT_CIRCRNAS = required_config("input_circrnas", config.get("input_circrnas"))
RUN_NAME = required_config("run_name", config.get("run_name"))
if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", RUN_NAME) is None:
    raise ValueError(
        "run_name must start with an alphanumeric character and contain only "
        "alphanumeric characters, dots, underscores, or hyphens"
    )

GENOME = required_config("genome", config.get("genome"))
ANNOTATION = required_config("annotation", config.get("annotation"))
PHYLOP = required_config("phyloP", config.get("phyloP"))
PHASTCONS = required_config("phastCons", config.get("phastCons"))
HUMAN_PRESENCE = required_config(
    "database_presence.human", config.get("database_presence", {}).get("human")
)
MOUSE_PRESENCE = required_config(
    "database_presence.mouse", config.get("database_presence", {}).get("mouse")
)
MOUSE_CHAIN = required_config(
    "mouse_liftover.chain", config.get("mouse_liftover", {}).get("chain")
)
CIRCFL_TABLE = required_config(
    "circfl.table", config.get("circfl", {}).get("table")
)
CIRCFL_CHAIN = required_config(
    "circfl.chain", config.get("circfl", {}).get("chain")
)
SCORE_RANK_REFERENCE = required_config(
    "score_rank_reference", config.get("score_rank_reference")
)

ANNOTATION_THREADS = int(config.get("annotation_boundary_threads", 8))
ANNOTATION_LRU_SIZE = int(config.get("annotation_worker_lru_size", 100000))
ANNOTATION_TARGETED_THRESHOLD = int(
    config.get("annotation_boundary_targeted_threshold", 100000)
)
CONSERVATION_THREADS = int(config.get("conservation_threads", 8))
CONSERVATION_LRU_SIZE = int(config.get("conservation_worker_lru_size", 100000))
MOUSE_LIFTOVER_THREADS = int(config.get("mouse_liftover", {}).get("threads", 8))
PREDICTCS_CHUNK_SIZE = int(config.get("predictCS", {}).get("chunk_size", 50000))

CHECKAA_CONFIG = config.get("checkAA", {})
CHECKAA_OTHER_REFERENCES = CHECKAA_CONFIG.get("other_references")
CHECKAA_THREADS = int(CHECKAA_CONFIG.get("threads", 8))
CHECKAA_FLANK_LENGTH = int(CHECKAA_CONFIG.get("flank_length", 50))
CHECKAA_CHUNK_SIZE = int(CHECKAA_CONFIG.get("chunk_size", 100000))

for name, value in (
    ("annotation_boundary_threads", ANNOTATION_THREADS),
    ("conservation_threads", CONSERVATION_THREADS),
    ("mouse_liftover.threads", MOUSE_LIFTOVER_THREADS),
    ("predictCS.chunk_size", PREDICTCS_CHUNK_SIZE),
    ("checkAA.threads", CHECKAA_THREADS),
    ("checkAA.flank_length", CHECKAA_FLANK_LENGTH),
    ("checkAA.chunk_size", CHECKAA_CHUNK_SIZE),
):
    if value <= 0:
        raise ValueError(f"{name} must be positive")

for name, value in (
    ("annotation_worker_lru_size", ANNOTATION_LRU_SIZE),
    ("annotation_boundary_targeted_threshold", ANNOTATION_TARGETED_THRESHOLD),
    ("conservation_worker_lru_size", CONSERVATION_LRU_SIZE),
):
    if value < 0:
        raise ValueError(f"{name} must be non-negative")


RUN_ROOT = f"results/runs/{RUN_NAME}"
WORK_ROOT = f"{RUN_ROOT}/work"
REFERENCE_ROOT = "results/references"

ACTIVE_CIRCRNAS = f"{RUN_ROOT}/circRNAs.tsv"
FEATURE_REQUESTS = f"{WORK_ROOT}/circRNAs.feature_requests.tsv"

ANNOTATION_DB = f"{REFERENCE_ROOT}/annotation/annotation.db"
AS_SITE_INDEX = f"{REFERENCE_ROOT}/alternative_splicing/annotation.AS_sites.tsv"
MOUSE_HG38 = f"{REFERENCE_ROOT}/mouse/mouse.database_presence.hg38.tsv"
MOUSE_UNMAPPED = f"{REFERENCE_ROOT}/mouse/mouse.database_presence.hg38.unmapped.tsv"
CIRCFL_HG38 = f"{REFERENCE_ROOT}/circFL/circRNA_circFL_table.hg38.tsv"
CIRCFL_UNMAPPED = f"{REFERENCE_ROOT}/circFL/circRNA_circFL_table.hg38.unmapped.tsv"
PREDICTCS_REFERENCE = f"{REFERENCE_ROOT}/predictCS/reference_support.sqlite"
SCORE_RANK_REFERENCE_ROOT = f"{REFERENCE_ROOT}/predictCS/score_rank_reference"
SCORE_COLUMNS = [
    "XGBoost_CS-R_score",
    "XGBoost_CS-C_score",
    "ElasticNet_CS-R_score",
    "ElasticNet_CS-C_score",
]
RANK_COLUMNS = [
    "XGBoost_CS-R_percentile_rank",
    "XGBoost_CS-C_percentile_rank",
    "ElasticNet_CS-R_percentile_rank",
    "ElasticNet_CS-C_percentile_rank",
]
SCORE_RANK_ARRAYS = [
    f"{SCORE_RANK_REFERENCE_ROOT}/{column}.npy" for column in SCORE_COLUMNS
]
SCORE_RANK_METADATA = f"{SCORE_RANK_REFERENCE_ROOT}/metadata.json"

ANNOTATION_RESULT = f"{WORK_ROOT}/features/annotation/circRNAs.annotation_boundaries.tsv"
AS_RESULT = f"{WORK_ROOT}/features/alternative_splicing/circRNAs.AS_check.tsv"

CONSERVATION_ROOT = f"{WORK_ROOT}/features/conservation"
CONSERVATION_CALCULABLE = f"{CONSERVATION_ROOT}/circRNAs.calculable.tsv"
CONSERVATION_CALCULATED = f"{CONSERVATION_ROOT}/circRNAs.conservation_scores.calculated.tsv"
CONSERVATION_UNAVAILABLE = f"{CONSERVATION_ROOT}/circRNAs.conservation_scores.unavailable.tsv"
CONSERVATION_RESULT = f"{CONSERVATION_ROOT}/circRNAs.conservation_scores.tsv"

SPLICING_ROOT = f"{WORK_ROOT}/features/splicing"
SPLICING_CALCULABLE = f"{SPLICING_ROOT}/circRNAs.calculable.tsv"
SPLICING_CALCULATED = f"{SPLICING_ROOT}/circRNAs.MaxEntScan_scores.calculated.tsv"
SPLICING_UNAVAILABLE = f"{SPLICING_ROOT}/circRNAs.MaxEntScan_scores.unavailable.tsv"
SPLICING_RESULT = f"{SPLICING_ROOT}/circRNAs.MaxEntScan_scores.tsv"
MAXENT_ROOT = f"{SPLICING_ROOT}/MaxEntScan"

FEATURES = f"{RUN_ROOT}/circRNAs.features.tsv"
DETAILED_FEATURES = f"{RUN_ROOT}/circRNAs.features.detailed.tsv"
PREDICTCS_SCORES = f"{RUN_ROOT}/circRNAs.predictCS_scores.tsv"
PREDICTCS_SCORE_RANKS = f"{RUN_ROOT}/circRNAs.predictCS_score_ranks.tsv"
RESULTS = f"{RUN_ROOT}/circRNAs.results.tsv"
DETAILED_RESULTS = f"{RUN_ROOT}/circRNAs.results.detailed.tsv"

CHECKAA_ROOT = f"{WORK_ROOT}/checkAA"
CHECKAA_CHUNKS = f"{CHECKAA_ROOT}/chunks"
CHECKAA_RESULT = f"{RUN_ROOT}/circRNAs.checkAA.tsv"
RESULTS_WITH_CHECKAA = f"{RUN_ROOT}/circRNAs.results.with_checkAA.tsv"
DETAILED_RESULTS_WITH_CHECKAA = f"{RUN_ROOT}/circRNAs.results.detailed.with_checkAA.tsv"


rule all:
    input:
        FEATURES,
        DETAILED_FEATURES,
        PREDICTCS_SCORES,
        PREDICTCS_SCORE_RANKS,
        RESULTS,
        DETAILED_RESULTS


rule checkAA:
    input:
        CHECKAA_RESULT,
        RESULTS_WITH_CHECKAA,
        DETAILED_RESULTS_WITH_CHECKAA


